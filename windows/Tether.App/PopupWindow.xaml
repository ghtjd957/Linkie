<Window x:Class="Tether.App.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tether"
        Width="372"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- 기기 한 줄: 마우스를 올리면 강조, 누르면 식별자 복사 -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="12" Padding="10,8" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 글자·아이콘만 있는 조용한 버튼(새로고침·종료) -->
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="6,4">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Copied}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <Button Style="{StaticResource RowButton}" Click="Row_Click" ToolTip="{Binding ToolTip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                            Background="{Binding AccentFill}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{Binding Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0"
                                   Style="{StaticResource DetailText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="2" CornerRadius="9" Padding="8,2,8,3" VerticalAlignment="Center"
                            Background="{Binding BatteryFill}" Visibility="{Binding BatteryVisibility}">
                        <TextBlock Text="{Binding BatteryText}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{Binding BatteryBrush}" />
                    </Border>
                    <Ellipse Grid.Column="2" Width="7" Height="7" Margin="0,0,4,0" VerticalAlignment="Center"
                             Fill="{Binding DotBrush}" Visibility="{Binding DotVisibility}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="SemiBold" Margin="10,0,0,4"
                           Foreground="{DynamicResource FaintBrush}" />
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- 바깥 여백은 그림자가 잘리지 않게 두는 자리 -->
    <Border Margin="16" CornerRadius="16" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 머리 -->
            <Grid Grid.Row="0" Margin="20,18,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="연결된 기기" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                <Border x:Name="CountPill" Grid.Column="1" Margin="8,1,0,0" CornerRadius="10" Padding="8,2,8,3"
                        Background="#3330B855" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Text="0" FontSize="11" FontWeight="Bold" Foreground="#FF30B855" />
                </Border>
                <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource QuietButton}"
                        Click="Refresh_Click" ToolTip="새로고침" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                </Button>
            </Grid>

            <!-- 목록 / 빈 상태 -->
            <ScrollViewer x:Name="ListScroll" Grid.Row="1" MaxHeight="460" Padding="10,0"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="SectionList" ItemTemplate="{StaticResource SectionTemplate}" />
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" Grid.Row="1" Margin="0,40,0,44" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE88E;" FontFamily="{StaticResource IconFont}" FontSize="28"
                           Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="연결된 기기가 없어요" FontSize="13" Margin="0,10,0,0"
                           Foreground="{DynamicResource SubBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 바닥 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="20,10,14,12">
                    <CheckBox x:Name="LoginCheck" Content="로그인 시 실행" FontSize="11"
                              Foreground="{DynamicResource SubBrush}" VerticalContentAlignment="Center"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Click="LoginCheck_Click" />
                    <Button Style="{StaticResource QuietButton}" Click="Quit_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="종료" FontSize="11" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
