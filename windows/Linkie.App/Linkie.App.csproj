<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 트레이 아이콘(NotifyIcon)만 WinForms 에서 빌려 쓴다. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- WPF 와 WinForms 의 같은 이름 타입(Application·Button·Clipboard…)이 충돌하지 않게 암시적 using 을 끈다. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Linkie.App</RootNamespace>
    <AssemblyName>Linkie</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Linkie.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Linkie.Core\Linkie.Core.csproj" />
    <EmbeddedResource Include="Scripts\pnp.ps1" LogicalName="pnp.ps1" />
  </ItemGroup>

</Project>
